# Rust
/target
**/target/
*.pdb
*.exe
# 例外：内置的 SC2Diff 是**构建输入**（tauri.conf.json 把它声明成 resource，
# tauri-build 找不到就直接报 failed to run custom build command）。
# 它必须入库，否则别人克隆下来编译不过 —— 本地一直有，所以这个坑只在干净克隆上才露出来。
!/src-tauri/resources/sc2diff.exe

# Node / Tauri
node_modules/
ui/dist/
src-tauri/gen/
src-tauri/target/

# 发布产物目录
/dist/

# Python（只剩 scripts/ 下的构建期脚本，无 uv 工程）
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# 本地素材与产物（体积大 / 含第三方版权资源，不入库）
/testdata/*.SC2Map
/testdata/*.SC2Mod
/testdata/**/*.SC2Map
/testdata/**/*.SC2Mod
/out/
/artifacts/
*.log

# 参考图 / 参考素材（别人的界面截图，含别人的真实目录结构，不入库）
/refs/

# 设计探索的草稿（方案定下来后就删，不入库）
/scratch/

# 编辑器 / 系统
Thumbs.db
desktop.ini
.DS_Store
